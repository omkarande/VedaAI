# Copy this file to .env.local and paste your key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional. Used ONLY when Gemini replies 429 (free tier spent), so paid
# credit is never touched while free requests remain. A wrong Gemini key
# returns 401 and does NOT fall through, so a typo stays visible.
# Key from https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# Optional overrides
# GEMINI_MODEL=gemini-3.6-flash
# Defaults to the OpenRouter twin of GEMINI_MODEL, so a fallback run behaves
# exactly like a direct one. Keep it on a Gemini model: the prompts ask for
# boxes on a 0-1000 grid and other families are much weaker at that.
# OPENROUTER_MODEL=google/gemini-3.6-flash
